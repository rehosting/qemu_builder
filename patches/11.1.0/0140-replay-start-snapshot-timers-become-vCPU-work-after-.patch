From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Sun, 25 Oct 2026 01:21:48 -0400
Subject: [PATCH] replay: start-snapshot timers become vCPU work after the
 load, against the loaded clock

Under record/replay, util/qemu-timer.c turns a virtual timer that is armed
already expired into vCPU work (timer_fire, no log event).  Loading the
start snapshot re-arms device timers while QEMU_CLOCK_VIRTUAL still runs at
the loading process's time: on x86 the APIC (MIG_PRI_APIC) loads before
the "timer" section that restores the clock.  x-rr-begin-record reloads its
snapshot at the snapshot's own time, so an APIC timer that was already due
when the VM stopped became vCPU work; the replaying process loads it from a
clock near 0, so the same timer went into the list, expired.  The replay
then needs a CHECKPOINT_CLOCK_VIRTUAL the log never has: the vCPU sees a
deadline of 0 on every round (icount_handle_deadline -> qemu_clock_notify ->
cpu_exit), breaks out before running its first instruction, and the replay
spins at icount 0 until killed (the x86 "replay hang": whenever the guest
was stopped with its APIC timer overdue).

timer_replay_load_begin/end bracket the load in x-rr-begin-record and
x-rr-begin-replay: during it virtual timers are only remembered, in arming
order; at the end each one that is due at the loaded time becomes vCPU
work.  The recorder's clock is already the loaded one, so it does what it
did before (recordings made without this replay with it); the replay now
matches it.
---
 include/qemu/timer.h  | 11 +++++++
 replay/replay-begin.c | 14 ++++++++-
 util/qemu-timer.c     | 67 +++++++++++++++++++++++++++++++++++++++++--
 3 files changed, 88 insertions(+), 4 deletions(-)

diff --git a/include/qemu/timer.h b/include/qemu/timer.h
index 9a62ac8cded11cc5c538117bda6826d33ff3cc76..6c01677f3c394da3cca506547d3b94a63bbde013 100644
--- a/include/qemu/timer.h
+++ b/include/qemu/timer.h
@@ -603,6 +603,17 @@ static inline QEMUTimer *timer_new_ms(QEMUClockType type, QEMUTimerCB *cb,
     return timer_new(type, SCALE_MS, cb, opaque);
 }
 
+/**
+ * timer_replay_load_begin:
+ * timer_replay_load_end:
+ *
+ * Bracket the load of a record/replay start snapshot: a virtual timer the
+ * load arms already expired becomes vCPU work at the end, judged against
+ * the loaded clock, not when it is armed.  Under the BQL.
+ */
+void timer_replay_load_begin(void);
+void timer_replay_load_end(void);
+
 /**
  * timer_deinit:
  * @ts: the timer to be de-initialised
diff --git a/replay/replay-begin.c b/replay/replay-begin.c
index fc2aef535d64e2cd9ebceece53a781287d8c2e22..6ab032426b8c04b1653dde99d634a8b2c49f6f4a 100644
--- a/replay/replay-begin.c
+++ b/replay/replay-begin.c
@@ -38,6 +38,7 @@
 #include "block/block_int.h"
 #include "hw/virtio/virtio-pci.h"
 #include "hw/virtio/virtio-mmio.h"
+#include "qemu/timer.h"
 #include "replay-internal.h"
 
 #define MAX_NETDEVS 64
@@ -212,10 +213,21 @@ static void rr_register_chardevs(RrBeginRecordInfo *info)
  * synchronous vCPU work (x86 vapic_post_load -> run_on_cpu); a vCPU thread
  * that has run blocks on the replay mutex this (main-loop) thread holds, so
  * run_on_cpu() hands the mutex over while it waits (0028).
+ *
+ * Record and replay must leave the load with the same virtual timers armed
+ * and the same ones turned into vCPU work, although they load from
+ * different clocks (the recorder's is already the snapshot's, a fresh
+ * replaying process's is near 0, and on x86 the APIC loads before the
+ * "timer" section): timer_replay_load_end() decides after the load.
  */
 static bool rr_load_start(const char *snapshot, Error **errp)
 {
-    return load_snapshot(snapshot, NULL, false, NULL, errp);
+    bool ok;
+
+    timer_replay_load_begin();
+    ok = load_snapshot(snapshot, NULL, false, NULL, errp);
+    timer_replay_load_end();
+    return ok;
 }
 
 /*
diff --git a/util/qemu-timer.c b/util/qemu-timer.c
index d93a020064fe2a82602c5739f4cb39a930d64a0e..f5cfc962081bf8425e2eec2e1c3600d565d09da2 100644
--- a/util/qemu-timer.c
+++ b/util/qemu-timer.c
@@ -395,6 +395,60 @@ static void timer_fire(CPUState *cpu, run_on_cpu_data data)
     t->cb(t->opaque);
 }
 
+/*
+ * Virtual timers armed while a record/replay start snapshot loads, in the
+ * order they were (last) armed; NULL outside timer_replay_load_begin/end.
+ */
+static GPtrArray *replay_load_timers;
+
+static bool timer_is_replay_virtual(QEMUTimerList *timer_list, QEMUTimer *ts)
+{
+    return replay_mode != REPLAY_MODE_NONE &&
+           timer_list->clock->type == QEMU_CLOCK_VIRTUAL &&
+           !(ts->attributes & QEMU_TIMER_ATTR_EXTERNAL);
+}
+
+/*
+ * Loading a snapshot re-arms device timers (vmstate timer fields, post_load
+ * hooks) while QEMU_CLOCK_VIRTUAL still runs at the loading process's time:
+ * the "timer" section that restores it may come after the devices.  So
+ * whether a timer that is already due at the snapshot's time looks expired
+ * when it is armed (and becomes vCPU work, see timer_mod_ns_locked) depends
+ * on the process: x-rr-begin-record reloads its start snapshot at that very
+ * time (yes), the replaying process loads it from a clock near 0 (no).  The
+ * replay then holds an expired timer that needs a CHECKPOINT_CLOCK_VIRTUAL
+ * the log does not have, and its vCPU spins on the deadline forever.
+ *
+ * Between these two calls the conversion is deferred; at the end every
+ * virtual timer armed during the load that is due at the loaded time
+ * becomes vCPU work, in arming order: the same work for record and replay.
+ */
+void timer_replay_load_begin(void)
+{
+    assert(!replay_load_timers);
+    replay_load_timers = g_ptr_array_new();
+}
+
+void timer_replay_load_end(void)
+{
+    GPtrArray *timers = replay_load_timers;
+    int64_t now;
+    guint i;
+
+    assert(timers);
+    replay_load_timers = NULL;
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    for (i = 0; i < timers->len; i++) {
+        QEMUTimer *ts = g_ptr_array_index(timers, i);
+
+        if (timer_expired_ns(ts, now) && first_cpu) {
+            timer_del(ts);
+            async_run_on_cpu(first_cpu, timer_fire, RUN_ON_CPU_HOST_PTR(ts));
+        }
+    }
+    g_ptr_array_free(timers, true);
+}
+
 static bool timer_mod_ns_locked(QEMUTimerList *timer_list,
                                 QEMUTimer *ts, int64_t expire_time)
 {
@@ -413,9 +467,11 @@ static bool timer_mod_ns_locked(QEMUTimerList *timer_list,
      *
      * Convert such timers to CPU work in order to avoid it.
      */
-    if (replay_mode != REPLAY_MODE_NONE &&
-        timer_list->clock->type == QEMU_CLOCK_VIRTUAL &&
-        !(ts->attributes & QEMU_TIMER_ATTR_EXTERNAL) &&
+    if (replay_load_timers && timer_is_replay_virtual(timer_list, ts)) {
+        /* decided at timer_replay_load_end() */
+        g_ptr_array_remove(replay_load_timers, ts);
+        g_ptr_array_add(replay_load_timers, ts);
+    } else if (timer_is_replay_virtual(timer_list, ts) &&
         expire_time <= qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)) {
         async_run_on_cpu(first_cpu, timer_fire,
                          RUN_ON_CPU_HOST_PTR(ts));
@@ -448,6 +504,11 @@ void timer_del(QEMUTimer *ts)
 {
     QEMUTimerList *timer_list = ts->timer_list;
 
+    if (replay_load_timers) {
+        /* not pending, and maybe about to be freed */
+        g_ptr_array_remove(replay_load_timers, ts);
+    }
+
     if (timer_list) {
         qemu_mutex_lock(&timer_list->active_timers_lock);
         timer_del_locked(timer_list, ts);
