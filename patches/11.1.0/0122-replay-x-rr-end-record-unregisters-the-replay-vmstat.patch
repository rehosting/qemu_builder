From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luke Craig <lacraig3@gmail.com>
Date: Sat, 24 Oct 2026 20:14:59 -0400
Subject: [PATCH] replay: x-rr-end-record unregisters the replay vmstate; a
 second begin works

x-rr-begin-record registers the "replay" vmstate for its start snapshot
and x-rr-end-record (0040) never unregistered it. Two consequences:

- a second x-rr-begin-record in the same process registers it again,
  and savevm_state_handler_insert() exits:
      Detected duplicate SaveStateEntry: id=replay, instance_id=0x0
- a savevm after the recording has ended runs replay_pre_save(), which
  calls ftell() on the closed (NULL) log.

Register once, unregister on x-rr-end-record and when a begin fails.
Also don't add a chardev to the replay list twice: each begin registers
its chardevs again.
---
 replay/replay-begin.c    |  2 ++
 replay/replay-char.c     |  3 ++-
 replay/replay-internal.h |  2 ++
 replay/replay-snapshot.c | 20 +++++++++++++++++++-
 4 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/replay/replay-begin.c b/replay/replay-begin.c
index a88b16186de4b23731bb17d72d38125898f673bf..f97355ecd6f244a3ede648ec0f620e4617445423 100644
--- a/replay/replay-begin.c
+++ b/replay/replay-begin.c
@@ -238,6 +238,7 @@ static void rr_rewind_log(void)
 static void rr_abandon(void)
 {
     replay_finish();
+    replay_vmstate_unregister();
     if (icount_by_begin) {
         icount_disable_runtime(&error_abort);
         icount_by_begin = false;
@@ -389,6 +390,7 @@ void qmp_x_rr_end_record(Error **errp)
         vm_stop(RUN_STATE_PAUSED);
     }
     replay_finish();
+    replay_vmstate_unregister();
     if (icount_by_begin) {
         icount_by_begin = false;
         if (!icount_disable_runtime(errp)) {
diff --git a/replay/replay-char.c b/replay/replay-char.c
index ca5268cafdf0d6ead2092908e4646c619a9a82aa..5a2392d1b61b0c4fd51f5e41b53c10bfb2a4e92b 100644
--- a/replay/replay-char.c
+++ b/replay/replay-char.c
@@ -43,7 +43,8 @@ static int find_char_driver(Chardev *chr)
 
 void replay_register_char_driver(Chardev *chr)
 {
-    if (replay_mode == REPLAY_MODE_NONE) {
+    /* each x-rr-begin-record registers its chardevs again */
+    if (replay_mode == REPLAY_MODE_NONE || find_char_driver(chr) >= 0) {
         return;
     }
     char_drivers = g_realloc(char_drivers,
diff --git a/replay/replay-internal.h b/replay/replay-internal.h
index 19273427947e3894406944cb4a464346525938b4..29e697b9e4bee4557e3ed021621d57ee20c71589 100644
--- a/replay/replay-internal.h
+++ b/replay/replay-internal.h
@@ -212,6 +212,8 @@ G_NORETURN void replay_sync_error(const char *error);
    Should be called before virtual devices initialization
    to make cached timers available for post_load functions. */
 void replay_vmstate_register(void);
+/* x-rr-end-record, or a failed x-rr-begin-* (replay-begin.c) */
+void replay_vmstate_unregister(void);
 
 /* x-rr-begin-record, x-rr-begin-replay (replay-begin.c) */
 bool replay_check_blockers(Error **errp);
diff --git a/replay/replay-snapshot.c b/replay/replay-snapshot.c
index 3c0a89442a94e2b4164e9e2cff396b57e80b16a8..7650df92efa483a00f4dc151ec8d0f45e5c0a7b1 100644
--- a/replay/replay-snapshot.c
+++ b/replay/replay-snapshot.c
@@ -65,9 +65,27 @@ static const VMStateDescription vmstate_replay = {
     },
 };
 
+static bool replay_vmstate_registered;
+
 void replay_vmstate_register(void)
 {
-    vmstate_register(NULL, 0, &vmstate_replay, &replay_state);
+    /* x-rr-begin-record/-replay register again for each recording */
+    if (!replay_vmstate_registered) {
+        vmstate_register(NULL, 0, &vmstate_replay, &replay_state);
+        replay_vmstate_registered = true;
+    }
+}
+
+/*
+ * x-rr-end-record: a snapshot taken after the recording has no log to
+ * point into (replay_pre_save reads replay_file's offset).
+ */
+void replay_vmstate_unregister(void)
+{
+    if (replay_vmstate_registered) {
+        vmstate_unregister(NULL, &vmstate_replay, &replay_state);
+        replay_vmstate_registered = false;
+    }
 }
 
 void replay_vmstate_init(void)
